<Window x:Class="FileMind.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:FileMind.Pages"
        Title="File Mind">
  <Grid x:Name="Root" RequestedTheme="Dark">
    <!-- The strip you drag the window by. It has no fill, so it never takes a click from the controls drawn over it;
         MainWindow.UpdateTitleRegions tells Windows which parts of it are buttons and boxes. -->
    <Grid x:Name="TitleBar" Height="48" VerticalAlignment="Top"/>

    <Grid x:Name="Shell" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="RailColumn" Width="276"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- The page fills the window to its right and bottom edges: no card, no border, no gap. -->
      <Grid x:Name="PanelCard" Grid.Column="1" Background="#E617171B">
        <Rectangle IsHitTestVisible="False" Fill="{StaticResource AuraBrush}"/>
        <Frame x:Name="ContentFrame"/>
        <!-- Frosted strip under the window buttons, so a page scrolling beneath them stays readable.
             The Library draws its own taller toolbar and hides this one. -->
        <Border x:Name="TopGlass" Height="48" VerticalAlignment="Top" IsHitTestVisible="False" Background="{StaticResource ToolbarGlassBrush}"/>
      </Grid>

      <!-- The sidebar is the window's own frosted glass, top to bottom: destinations, filters, settings. -->
      <Grid x:Name="RailCard" Padding="10,10,10,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="NavStack" Spacing="1" Margin="0,0,0,14"/>
        <ContentControl x:Name="SidebarHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <ToggleButton x:Name="SettingsRail" Grid.Row="2" Style="{StaticResource RailItem}" MinHeight="32" Margin="0,6,0,0" Click="OpenSettings_Click"
                      AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings (Ctrl+,)">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <p:LineIcon Kind="f-settings" Size="16" Opacity="0.75" VerticalAlignment="Center"/>
            <TextBlock Text="Settings" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
      </Grid>

      <!-- Settings slide in from the right, below the window buttons -->
      <Grid x:Name="SettingsScrim" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{StaticResource ScrimBrush}" Tapped="SettingsScrim_Tapped">
        <Border x:Name="SettingsPanel" HorizontalAlignment="Right" Width="520" Margin="0,48,0,0" CornerRadius="8,0,0,0" Background="{StaticResource OverlayBrush}"
                BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1,1,0,0" Tapped="SettingsPanel_Tapped">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="24,18,14,6">
              <TextBlock Text="Settings" Style="{StaticResource TitleText}" FontSize="24"/>
              <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Right" Padding="9,8" Click="CloseSettings_Click" AutomationProperties.Name="Close settings">
                <p:LineIcon Kind="close" Size="13"/></Button>
            </Grid>
            <Frame x:Name="SettingsFrame" Grid.Row="1"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- First run, engine start-up and model download happen here, over the shell. -->
    <Frame x:Name="SetupFrame" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}"/>
  </Grid>
</Window>
