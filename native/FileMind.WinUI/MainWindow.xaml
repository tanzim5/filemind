<Window x:Class="FileMind.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:FileMind.Pages"
        Title="File Mind">
  <Grid x:Name="Root" RequestedTheme="Dark">
    <!-- The strip you drag the window by. It has no fill, so it never takes a click from the controls drawn over it;
         MainWindow.UpdateTitleRegions tells Windows which parts of it are buttons and boxes. -->
    <Grid x:Name="TitleBar" Height="48" VerticalAlignment="Top"/>

    <Grid x:Name="Shell" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="RailColumn" Width="248"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- The page fills the window to its right and bottom edges: no card, no border, no gap. -->
      <Grid x:Name="PanelCard" Grid.Column="1" Background="#E617171B">
        <Rectangle IsHitTestVisible="False" Fill="{StaticResource AuraBrush}"/>
        <Frame x:Name="ContentFrame"/>
        <!-- The permanent top bar: back and forward, the page title, the page's own actions, and room for the window buttons.
             It is frosted, so a page scrolling beneath it stays readable. -->
        <Border x:Name="TopBar" Height="48" VerticalAlignment="Top" Background="{StaticResource ToolbarGlassBrush}">
          <Grid Padding="14,0,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="NavButtons" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <Button x:Name="BackBtn" Style="{StaticResource BarButton}" IsEnabled="False" Click="NavBack_Click" AutomationProperties.Name="Back" ToolTipService.ToolTip="Back">
                <p:LineIcon Kind="back" Size="16"/></Button>
              <Button x:Name="FwdBtn" Style="{StaticResource BarButton}" IsEnabled="False" Click="NavFwd_Click" AutomationProperties.Name="Forward" ToolTipService.ToolTip="Forward">
                <p:LineIcon Kind="fwd" Size="16"/></Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="560" VerticalAlignment="Center"/>
              <TextBlock x:Name="TitleNote" Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
            <ContentControl x:Name="ActionsHost" Grid.Column="2" VerticalAlignment="Center" HorizontalContentAlignment="Right" IsTabStop="False"/>
          </Grid>
        </Border>
      </Grid>

      <!-- The sidebar is the window's own frosted glass, top to bottom: destinations, filters, settings. -->
      <Grid x:Name="RailCard" Padding="10,50,10,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="NavStack" Spacing="1" Margin="0,0,0,12"/>
        <ContentControl x:Name="SidebarHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <ToggleButton x:Name="SettingsRail" Grid.Row="2" Style="{StaticResource RailItem}" MinHeight="30" Margin="0,6,0,0" Click="OpenSettings_Click"
                      AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings (Ctrl+,)">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <p:LineIcon Kind="f-settings" Size="16" Opacity="0.75" VerticalAlignment="Center"/>
            <TextBlock Text="Settings" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>
      </Grid>

      <!-- Exports in progress and their result: a small frosted card in the corner, out of the way of the tiles. -->
      <Border x:Name="ExportTray" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18" Width="330"
              Padding="14,12" CornerRadius="8" Background="{StaticResource ToolbarGlassBrush}" BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1">
        <StackPanel Spacing="8">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ExportTitle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="ExportClose" Grid.Column="1" Style="{StaticResource GlassButton}" Padding="7,6" CornerRadius="5" Click="ExportClose_Click" AutomationProperties.Name="Dismiss">
              <p:LineIcon Kind="close" Size="11"/></Button>
          </Grid>
          <TextBlock x:Name="ExportNote" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
          <ProgressBar x:Name="ExportBar" Minimum="0" Maximum="1"/>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="ExportCancel" Style="{StaticResource GlassButton}" Content="Cancel" Padding="12,6" Click="ExportCancel_Click"/>
            <Button x:Name="ExportShow" Style="{StaticResource GlassAccentButton}" Content="Show in folder" Padding="12,6" Click="ExportShow_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Settings slide in from the right, below the window buttons -->
      <Grid x:Name="SettingsScrim" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{StaticResource ScrimBrush}" Tapped="SettingsScrim_Tapped">
        <Border x:Name="SettingsPanel" HorizontalAlignment="Right" Width="520" Margin="0,48,0,0" CornerRadius="8,0,0,0" Background="{StaticResource OverlayBrush}"
                BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1,1,0,0" Tapped="SettingsPanel_Tapped">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="24,18,14,6">
              <TextBlock Text="Settings" Style="{StaticResource TitleText}" FontSize="24"/>
              <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Right" Padding="9,8" Click="CloseSettings_Click" AutomationProperties.Name="Close settings">
                <p:LineIcon Kind="close" Size="13"/></Button>
            </Grid>
            <Frame x:Name="SettingsFrame" Grid.Row="1"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- First run, engine start-up and model download happen here, over the shell. -->
    <Frame x:Name="SetupFrame" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}"/>
  </Grid>
</Window>
