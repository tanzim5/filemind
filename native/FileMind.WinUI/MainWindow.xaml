<Window x:Class="FileMind.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:FileMind.Pages"
        Title="File Mind">
  <Grid x:Name="Root" RequestedTheme="Dark">
    <Grid.RowDefinitions>
      <RowDefinition Height="32"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBar" Padding="16,0,0,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/icon.png" Width="18" Height="18"/>
        <TextBlock Text="File Mind" FontSize="12" Foreground="{StaticResource GlassTextSecondaryBrush}"/>
      </StackPanel>
    </Grid>

    <Grid x:Name="Shell" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="288"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- The left rail: destinations on top, the page's filters below (fixed). Settings lives in the panel on the right. -->
      <Border x:Name="RailCard" Style="{StaticResource GlassCard}" Margin="8,0,0,8" Padding="8,6,8,6" CornerRadius="8" BorderThickness="1">
        <Grid RowSpacing="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Margin="10,2,2,4">
            <TextBlock Text="File Mind" Style="{StaticResource TitleText}" FontSize="24" VerticalAlignment="Center"/>
            <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Right" Padding="9,7" CornerRadius="6" Click="OpenSettings_Click"
                    ToolTipService.ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings">
              <p:LineIcon Kind="settings" Size="15"/></Button>
          </Grid>
          <StackPanel x:Name="NavStack" Grid.Row="1" Spacing="2"/>
          <ContentControl x:Name="SidebarHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
      </Border>

      <!-- The page itself sits on a calm solid panel that runs to the bottom of the window; its edges are faded, never cut. -->
      <Border x:Name="PanelCard" Grid.Column="1" Margin="8,0,8,8" CornerRadius="8" Background="#E617171B" BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1">
        <Frame x:Name="ContentFrame"/>
      </Border>

      <!-- Settings, tucked away on the right -->
      <Grid x:Name="SettingsScrim" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{StaticResource ScrimBrush}" Tapped="SettingsScrim_Tapped">
        <Border x:Name="SettingsPanel" HorizontalAlignment="Right" Width="440" Margin="0" CornerRadius="8,0,0,0" Background="{StaticResource OverlayBrush}"
                BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1" Tapped="SettingsPanel_Tapped">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="24,18,14,0">
              <TextBlock Text="Settings" Style="{StaticResource TitleText}" FontSize="30"/>
              <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Right" Padding="9,8" CornerRadius="6" Click="CloseSettings_Click" AutomationProperties.Name="Close settings">
                <p:LineIcon Kind="close" Size="14"/></Button>
            </Grid>
            <Frame x:Name="SettingsFrame" Grid.Row="1"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- First run, engine start-up and model download happen here, over the shell. -->
    <Frame x:Name="SetupFrame" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}"/>
  </Grid>
</Window>

