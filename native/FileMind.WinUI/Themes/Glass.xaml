<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScalarTransition x:Key="HoverFade" Duration="0:0:0.14"/>
  <!-- Geist (Vercel, SIL OFL) for all text; the folder form loads every weight bundled in Assets/Fonts. -->
  <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/#Geist</FontFamily>
  <FontFamily x:Key="AppFont">ms-appx:///Assets/Fonts/#Geist</FontFamily>
  <!-- Instrument Serif (SIL OFL) for page titles and the search field. -->
  <FontFamily x:Key="SerifFont">ms-appx:///Assets/Fonts/#Instrument Serif</FontFamily>


  <!-- File Mind's orange as the system accent. -->
  <Color x:Key="SystemAccentColor">#FF5A1F</Color>
  <Color x:Key="SystemAccentColorLight1">#FF7A45</Color>
  <Color x:Key="SystemAccentColorLight2">#FF9A70</Color>
  <Color x:Key="SystemAccentColorLight3">#FFB899</Color>
  <Color x:Key="SystemAccentColorDark1">#E04A12</Color>
  <Color x:Key="SystemAccentColorDark2">#B83A0C</Color>
  <Color x:Key="SystemAccentColorDark3">#902C08</Color>

  <!-- Frosted glass: a faint white veil over the blurred window backdrop, a light edge that is brighter
       at the top-left (as if lit from above), and generous rounding. -->
  <SolidColorBrush x:Key="GlassFillBrush" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="GlassFillStrongBrush" Color="#24FFFFFF"/>
  <SolidColorBrush x:Key="GlassFillHoverBrush" Color="#1FFFFFFF"/>
  <SolidColorBrush x:Key="GlassTextSecondaryBrush" Color="#B3FFFFFF"/>
  <SolidColorBrush x:Key="GlassTextTertiaryBrush" Color="#80FFFFFF"/>
  <!-- Full-strength text, for icons and values that must always read (recoloured by ThemeEngine). -->
  <SolidColorBrush x:Key="GlassTextPrimaryBrush" Color="#FFFFFFFF"/>
  <!-- The search field: a solid fill with a clear edge (recoloured by ThemeEngine). -->
  <SolidColorBrush x:Key="FieldFillBrush" Color="#22FFFFFF"/>
  <SolidColorBrush x:Key="FieldBorderBrush" Color="#44FFFFFF"/>

  <LinearGradientBrush x:Key="GlassStrokeBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#40FFFFFF" Offset="0"/>
    <GradientStop Color="#10FFFFFF" Offset="0.5"/>
    <GradientStop Color="#22FFFFFF" Offset="1"/>
  </LinearGradientBrush>

  <!-- Liquid glass only: a faint highlight along the inside of the top edge (transparent in frosted mode; recoloured by ThemeEngine). -->
  <LinearGradientBrush x:Key="LiquidSheenBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#00FFFFFF" Offset="0"/>
    <GradientStop Color="#00FFFFFF" Offset="0.55"/>
  </LinearGradientBrush>

  <!-- Liquid glass only: a 1 px bright-on-top edge drawn over buttons and chips (transparent in frosted mode). -->
  <LinearGradientBrush x:Key="LiquidEdgeBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#00FFFFFF" Offset="0"/>
    <GradientStop Color="#00FFFFFF" Offset="0.5"/>
    <GradientStop Color="#00FFFFFF" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="TileScrimBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#00000000" Offset="0"/>
    <GradientStop Color="#99000000" Offset="1"/>
  </LinearGradientBrush>

  <Style x:Key="GlassCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource GlassFillBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="20"/>
  </Style>

  <Style x:Key="GlassPill" TargetType="Border" BasedOn="{StaticResource GlassCard}">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="18,0"/>
  </Style>

  <Style x:Key="TitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SerifFont}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="FontSize" Value="40"/>
  </Style>

  <Style x:Key="SecondaryText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource GlassTextSecondaryBrush}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <SolidColorBrush x:Key="AccentTintBrush" Color="#4DFF5A1F"/>
  <SolidColorBrush x:Key="AccentFillBrush" Color="#CCFF5A1F"/>
  <SolidColorBrush x:Key="AccentOnFillBrush" Color="#66FF5A1F"/>
  <SolidColorBrush x:Key="AccentOnStrokeBrush" Color="#99FF7A45"/>
  <SolidColorBrush x:Key="GlassHighlightBrush" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="GlassHoverSoftBrush" Color="#14FFFFFF"/>
  <!-- Frosted toolbar: blurs the tiles scrolling beneath it (recoloured by ThemeEngine). -->
  <AcrylicBrush x:Key="ToolbarGlassBrush" TintColor="#0C0D14" TintOpacity="0.62" TintLuminosityOpacity="0.72" FallbackColor="#F20C0D14"/>
  <SolidColorBrush x:Key="AccentTintStrongBrush" Color="#80FF5A1F"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1B1B21"/>
  <SolidColorBrush x:Key="OverlayBrush" Color="#F01D1D22"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#1FFFFFFF"/>
  <SolidColorBrush x:Key="ScrimBrush" Color="#66000000"/>
  <!-- A soft glow of the accent colour in the top corner of the page panel (recoloured by ThemeEngine). -->
  <RadialGradientBrush x:Key="AuraBrush" Center="0.92,-0.05" GradientOrigin="0.92,-0.05" RadiusX="0.75" RadiusY="0.7">
    <GradientStop Color="#24FF5A1F" Offset="0"/>
    <GradientStop Color="#00FF5A1F" Offset="1"/>
  </RadialGradientBrush>
  <SolidColorBrush x:Key="AccentBrush" Color="#FFFF5A1F"/>

  <!-- Glass button: a frosted capsule that brightens under the pointer. -->
  <Style x:Key="GlassButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource GlassFillBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/>
            <Border x:Name="Hl" Background="{StaticResource GlassHighlightBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" OpacityTransition="{StaticResource HoverFade}"/>
            <Border BorderBrush="{StaticResource LiquidEdgeBrush}" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
            <ContentPresenter Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Foreground="{TemplateBinding Foreground}"/>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hl.Opacity" Value="1"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hl.Opacity" Value="0.75"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Bg.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GlassAccentButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
    <Setter Property="Background" Value="{StaticResource AccentFillBrush}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>

  <Style x:Key="GlassChip" TargetType="ToggleButton">
    <Setter Property="Background" Value="{StaticResource GlassFillBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Padding" Value="11,5"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/>
            <Border x:Name="On" Background="{StaticResource AccentOnFillBrush}" BorderBrush="{StaticResource AccentOnStrokeBrush}" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" OpacityTransition="{StaticResource HoverFade}"/>
            <Border x:Name="Hl" Background="{StaticResource GlassHighlightBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" OpacityTransition="{StaticResource HoverFade}"/>
            <Border BorderBrush="{StaticResource LiquidEdgeBrush}" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
            <ContentPresenter Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Foreground="{TemplateBinding Foreground}"/>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hl.Opacity" Value="1"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hl.Opacity" Value="0.75"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="On.Opacity" Value="1"/></VisualState.Setters></VisualState>
                <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="On.Opacity" Value="1"/><Setter Target="Hl.Opacity" Value="0.6"/></VisualState.Setters></VisualState>
                <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="On.Opacity" Value="0.8"/></VisualState.Setters></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Boxed 30 px button for the top bars (back, forward, sort, layout, size): hairline border, radius 7. -->
  <Style x:Key="BoxButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
    <Setter Property="Background" Value="{StaticResource FieldFillBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="MinWidth" Value="30"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="BoxAccentButton" TargetType="Button" BasedOn="{StaticResource BoxButton}">
    <Setter Property="Background" Value="{StaticResource AccentFillBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>

  <Style x:Key="SectionLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource GlassTextSecondaryBrush}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Small icon button for the top bar: no border until the pointer is over it. -->
  <Style x:Key="BarButton" TargetType="Button">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Border x:Name="Hl" Background="{StaticResource GlassHighlightBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" OpacityTransition="{StaticResource HoverFade}"/>
            <ContentPresenter x:Name="Cp" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="{TemplateBinding Padding}" Foreground="{StaticResource GlassTextPrimaryBrush}"/>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hl.Opacity" Value="1"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hl.Opacity" Value="1"/><Setter Target="Cp.Opacity" Value="0.7"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Cp.Opacity" Value="0.35"/></VisualState.Setters></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Sidebar and page chrome become transparent so the acrylic window shows through. -->
  <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
  <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>


  <!-- Left-rail destination: a quiet row that lights up when selected. -->
  <Style x:Key="RailItem" TargetType="ToggleButton">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid MinHeight="{TemplateBinding MinHeight}">
            <Border x:Name="On" Background="{StaticResource GlassHighlightBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" OpacityTransition="{StaticResource HoverFade}"/>
            <Border x:Name="Hl" Background="{StaticResource GlassHoverSoftBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" OpacityTransition="{StaticResource HoverFade}"/>
            <ContentPresenter Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hl.Opacity" Value="1"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hl.Opacity" Value="1"/><Setter Target="On.Opacity" Value="0.6"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="On.Opacity" Value="1"/></VisualState.Setters></VisualState>
                <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="On.Opacity" Value="1"/></VisualState.Setters></VisualState>
                <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="On.Opacity" Value="1"/></VisualState.Setters></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A settings row: icon, title and hint on the left, the control on the right. -->
  <Style x:Key="SettingRow" TargetType="Grid">
    <Setter Property="Padding" Value="14,11"/>
    <Setter Property="ColumnSpacing" Value="14"/>
  </Style>

  <!-- A row of the quick search list: no box, a soft hover, and the chosen row filled with a gentle tint of the accent. -->
  <Style x:Key="QuickRow" TargetType="ListViewItem">
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Grid>
            <Border x:Name="Bg" CornerRadius="8" Background="Transparent"/>
            <Border x:Name="Sel" CornerRadius="8" Background="{StaticResource AccentTintBrush}" Opacity="0" OpacityTransition="{StaticResource HoverFade}"/>
            <ContentPresenter Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Bg.Background" Value="{StaticResource GlassHoverSoftBrush}"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Bg.Background" Value="{StaticResource GlassHoverSoftBrush}"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="Sel.Opacity" Value="1"/></VisualState.Setters></VisualState>
                <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="Sel.Opacity" Value="1"/></VisualState.Setters></VisualState>
                <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="Sel.Opacity" Value="1"/></VisualState.Setters></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
