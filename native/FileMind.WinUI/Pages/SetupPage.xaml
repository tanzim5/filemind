<Page x:Class="FileMind.Pages.SetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Border Style="{StaticResource GlassCard}" Width="640" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,36">
      <StackPanel Spacing="22">
        <StackPanel Spacing="14" HorizontalAlignment="Center">
          <Image Source="ms-appx:///Assets/icon.png" Width="72" Height="72" HorizontalAlignment="Center"/>
          <TextBlock x:Name="Headline" Style="{StaticResource TitleText}" HorizontalAlignment="Center" Text="Getting File Mind ready"/>
          <TextBlock x:Name="Detail" Style="{StaticResource SecondaryText}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Progress -->
        <StackPanel x:Name="BusyPanel" Spacing="10" Visibility="Collapsed">
          <ProgressBar x:Name="Bar" IsIndeterminate="True" Minimum="0" Maximum="1"/>
          <TextBlock x:Name="BusyText" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Something went wrong -->
        <StackPanel x:Name="ErrorPanel" Spacing="14" Visibility="Collapsed">
          <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#FFFF8A80"/>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Button Content="Try again" Style="{StaticResource AccentButtonStyle}" Click="Retry_Click"/>
            <Button x:Name="UseCpuButton" Content="Use the processor instead" Click="UseCpu_Click"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Page>
