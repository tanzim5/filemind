<Page x:Class="FileMind.Pages.SetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Stage">
    <StackPanel x:Name="Centre" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
      <TextBlock x:Name="Headline" Style="{StaticResource TitleText}" FontSize="36" HorizontalAlignment="Center" TextAlignment="Center" Text="Starting File Mind"/>
      <TextBlock x:Name="Detail" Style="{StaticResource SecondaryText}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

      <!-- Progress: one quiet thin line and what is happening -->
      <StackPanel x:Name="BusyPanel" Spacing="12" Visibility="Collapsed" Margin="0,8,0,0">
        <ProgressBar x:Name="Bar" IsIndeterminate="True" Minimum="0" Maximum="1" Width="260" Height="3" CornerRadius="2"/>
        <TextBlock x:Name="BusyText" Style="{StaticResource SecondaryText}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
      </StackPanel>

      <!-- Something went wrong -->
      <StackPanel x:Name="ErrorPanel" Spacing="14" Visibility="Collapsed">
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" TextAlignment="Center" Foreground="#FFFF8A80"/>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
          <Button Content="Try again" Style="{StaticResource GlassAccentButton}" Padding="18,7" Click="Retry_Click"/>
          <Button x:Name="UseCpuButton" Content="Use the processor instead" Style="{StaticResource GlassButton}" Padding="16,7" Click="UseCpu_Click"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Grid>
</Page>
