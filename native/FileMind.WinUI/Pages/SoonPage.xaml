<Page x:Class="FileMind.Pages.SoonPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="40">
    <Border Style="{StaticResource GlassCard}" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36">
      <StackPanel Spacing="10">
        <TextBlock x:Name="Heading" Style="{StaticResource TitleText}"/>
        <TextBlock x:Name="Blurb" Style="{StaticResource SecondaryText}" FontSize="15" TextWrapping="Wrap"/>
        <TextBlock Text="This part of the native app is still being built. The full version is in the web app for now."
                   Style="{StaticResource SecondaryText}" Foreground="{StaticResource GlassTextTertiaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Page>
