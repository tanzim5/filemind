<Page x:Class="FileMind.Pages.DiscoverPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:FileMind.Pages">
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
      <StackPanel Padding="44,40,44,90" Spacing="40">
        <StackPanel Spacing="12">
          <TextBlock Text="See your library differently" Style="{StaticResource SectionLabel}" Foreground="#FFFF7A45"/>
          <TextBlock Text="Discover what’s already here." Style="{StaticResource TitleText}" FontSize="64"/>
          <TextBlock Text="Fresh paths through the files File Mind has read, shaped by visual similarity and file metadata."
                     Style="{StaticResource SecondaryText}" FontSize="15" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel x:Name="ThemesBox" Spacing="16" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock Text="Visual themes" Style="{StaticResource TitleText}" FontSize="30"/>
            <TextBlock Text="Explore what the images show" Style="{StaticResource SecondaryText}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
          </StackPanel>
          <local:WrapPanel x:Name="Themes" Spacing="26"/>
        </StackPanel>

        <StackPanel x:Name="QuestionsBox" Spacing="16" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock Text="Questions worth asking" Style="{StaticResource TitleText}" FontSize="30"/>
            <TextBlock Text="Open-ended searches for the files already in your library" Style="{StaticResource SecondaryText}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
          </StackPanel>
          <Grid x:Name="Questions" ColumnSpacing="12" RowSpacing="12" SizeChanged="Questions_SizeChanged"/>
        </StackPanel>

        <StackPanel x:Name="DeeperBox" Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock Text="Explore deeper" Style="{StaticResource TitleText}" FontSize="30"/>
            <TextBlock Text="More ways to work with your files" Style="{StaticResource SecondaryText}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
          </StackPanel>
          <local:WrapPanel x:Name="Deeper" Spacing="14"/>
        </StackPanel>

        <StackPanel x:Name="ThoughtsBox" Spacing="16" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock Text="Try a thought" Style="{StaticResource TitleText}" FontSize="30"/>
            <TextBlock Text="Search your library by meaning" Style="{StaticResource SecondaryText}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
          </StackPanel>
          <local:WrapPanel x:Name="Thoughts" Spacing="10"/>
        </StackPanel>

        <StackPanel x:Name="TypesBox" Spacing="16" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock Text="By file type" Style="{StaticResource TitleText}" FontSize="30"/>
            <TextBlock Text="Quick ways into your collection" Style="{StaticResource SecondaryText}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
          </StackPanel>
          <local:WrapPanel x:Name="Types" Spacing="14"/>
        </StackPanel>

        <TextBlock x:Name="Note" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
    <Rectangle Height="26" VerticalAlignment="Top" IsHitTestVisible="False" Fill="{StaticResource FadeTopBrush}"/>
    <Rectangle Height="80" VerticalAlignment="Bottom" IsHitTestVisible="False" Fill="{StaticResource FadeBottomBrush}"/>
  </Grid>
</Page>
