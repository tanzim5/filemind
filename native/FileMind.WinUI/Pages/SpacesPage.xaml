<Page x:Class="FileMind.Pages.SpacesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:FileMind.Pages">
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
      <StackPanel Padding="40,72,40,60" Spacing="28">
        <TextBlock x:Name="YourTitle" Visibility="Collapsed" Text="Your spaces" Style="{StaticResource TitleText}" FontSize="26"/>
        <local:WrapPanel x:Name="Cards" Spacing="26" SizeChanged="Grid_SizeChanged"/>

        <!-- Groups the engine proposes from files in no space: each is a dashed stack you can keep or dismiss. Nothing is made until Keep. -->
        <StackPanel x:Name="SuggestBox" Visibility="Collapsed" Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock Text="Suggested" Style="{StaticResource TitleText}" FontSize="26"/>
            <TextBlock x:Name="SuggestNote" Style="{StaticResource SecondaryText}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
          </StackPanel>
          <local:WrapPanel x:Name="Review" Spacing="26" SizeChanged="Grid_SizeChanged"/>
        </StackPanel>
        <TextBlock x:Name="Note" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
