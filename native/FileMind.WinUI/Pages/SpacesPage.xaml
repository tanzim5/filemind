<Page x:Class="FileMind.Pages.SpacesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:FileMind.Pages">
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
      <StackPanel Padding="40,72,40,60" Spacing="28">
        <!-- What "Organise for me" found: each group is a stack you can keep or dismiss. -->
        <StackPanel x:Name="ReviewBox" Visibility="Collapsed" Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock Text="Suggested spaces" Style="{StaticResource TitleText}" FontSize="26"/>
            <TextBlock x:Name="ReviewNote" Style="{StaticResource SecondaryText}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            <Button Style="{StaticResource GlassButton}" VerticalAlignment="Bottom" Padding="12,4" CornerRadius="6" Click="CloseReview_Click"><TextBlock Text="Done" FontSize="12.5"/></Button>
          </StackPanel>
          <local:WrapPanel x:Name="Review" Spacing="26" SizeChanged="Grid_SizeChanged"/>
        </StackPanel>

        <TextBlock x:Name="YourTitle" Visibility="Collapsed" Text="Your spaces" Style="{StaticResource TitleText}" FontSize="26"/>
        <local:WrapPanel x:Name="Cards" Spacing="26" SizeChanged="Grid_SizeChanged"/>
        <TextBlock x:Name="Note" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
