<Page x:Class="FileMind.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:FileMind.Pages">
  <ScrollViewer VerticalScrollBarVisibility="Hidden">
    <StackPanel Padding="24,8,24,40" Spacing="18" MaxWidth="820" HorizontalAlignment="Left">
      <Border Style="{StaticResource GlassCard}">
        <StackPanel Spacing="14">
          <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Theme" Style="{StaticResource SecondaryText}"/>
          <local:WrapPanel x:Name="ThemeChips" Spacing="8"/>
          <TextBlock Text="Accent colour" Style="{StaticResource SecondaryText}"/>
          <StackPanel x:Name="AccentRow" Orientation="Horizontal" Spacing="10"/>
          <Grid>
            <TextBlock Text="Transparency" Style="{StaticResource SecondaryText}"/>
            <TextBlock x:Name="GlassValue" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}"/>
          </Grid>
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Solid" FontSize="12" VerticalAlignment="Center" Style="{StaticResource SecondaryText}"/>
            <Slider x:Name="GlassSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="5" ValueChanged="Glass_Changed"/>
            <TextBlock Grid.Column="2" Text="Glass" FontSize="12" VerticalAlignment="Center" Style="{StaticResource SecondaryText}"/>
          </Grid>
          <TextBlock Text="Lower is more see-through, showing your desktop through the glass." Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource GlassCard}">
        <StackPanel Spacing="14">
          <TextBlock Text="Library" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Layout" Style="{StaticResource SecondaryText}"/>
          <StackPanel x:Name="LayoutRow" Orientation="Horizontal" Spacing="8"/>
          <TextBlock x:Name="SizeLabel" Style="{StaticResource SecondaryText}"/>
          <Slider x:Name="SizeSlider" Minimum="140" Maximum="560" StepFrequency="10" ValueChanged="Look_Changed"/>
          <TextBlock x:Name="GapLabel" Style="{StaticResource SecondaryText}"/>
          <Slider x:Name="GapSlider" Minimum="2" Maximum="32" StepFrequency="1" ValueChanged="Look_Changed"/>
          <ToggleSwitch x:Name="NamesSwitch" Header="Show file names under every tile" Toggled="Names_Toggled"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource GlassCard}">
        <StackPanel Spacing="14">
          <TextBlock Text="Sidebar" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Menu" Style="{StaticResource SecondaryText}"/>
          <StackPanel x:Name="MenuList" Spacing="4"/>
          <TextBlock Text="Library filter sections" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
          <StackPanel x:Name="SectionList" Spacing="4"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource GlassCard}">
        <StackPanel Spacing="12">
          <TextBlock Text="Playback" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="VolumeLabel" Style="{StaticResource SecondaryText}"/>
          <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" ValueChanged="Volume_Changed"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource GlassCard}">
        <StackPanel Spacing="14">
          <TextBlock Text="Engine" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="Running" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
          <TextBlock x:Name="GpuLine" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
          <RadioButtons x:Name="Choice" Header="Run the AI model on">
            <RadioButton Tag="auto" Content="Automatic (recommended)"/>
            <RadioButton Tag="nvidia" x:Name="NvidiaRadio" Content="NVIDIA GPU (CUDA)"/>
            <RadioButton Tag="cpu" Content="CPU"/>
          </RadioButtons>
          <TextBlock x:Name="ChoiceNote" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
          <Button x:Name="Apply" Content="Apply and restart the engine" Click="Apply_Click" Style="{StaticResource GlassAccentButton}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource GlassCard}">
        <StackPanel Spacing="12">
          <TextBlock Text="Folders" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="File Mind only reads these. Removing one forgets it in File Mind and never touches the files." Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
          <ItemsControl x:Name="Roots">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{x:Bind}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource GlassCard}">
        <StackPanel Spacing="10">
          <TextBlock Text="About" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="About" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Open data folder" Click="OpenData_Click" Style="{StaticResource GlassButton}"/>
            <Button Content="Reset appearance and layout" Click="Reset_Click" Style="{StaticResource GlassButton}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
