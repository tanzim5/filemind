<Page x:Class="FileMind.Pages.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:FileMind.Pages">
  <Page.Resources>
    <local:TileLayout x:Key="TileLayoutInstance"/>

    <DataTemplate x:Key="TileTemplate" x:DataType="local:TileVm">
      <Grid CornerRadius="6" Background="{StaticResource GlassFillBrush}" CanDrag="True" Tag="{x:Bind}"
            DragStarting="Tile_DragStarting" Tapped="Tile_Tapped"
            PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
        <Image Source="{x:Bind Thumb}" Stretch="UniformToFill" Visibility="{x:Bind ThumbVisible}"/>
        <local:LineIcon Kind="{x:Bind IconKind}" Size="38" Opacity="0.5" Visibility="{x:Bind GlyphVisible}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <local:AudioCard Vm="{x:Bind}" Visibility="{x:Bind AudioVisible}"/>
        <Rectangle Fill="{StaticResource TileScrimBrush}" Height="70" VerticalAlignment="Bottom"
                   Visibility="{x:Bind NameVisible, Mode=OneWay}"/>
        <TextBlock Text="{x:Bind Name}" FontSize="12" Margin="12,0,12,10" VerticalAlignment="Bottom"
                   TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="White"
                   Visibility="{x:Bind NameVisible, Mode=OneWay}"/>
        <Border Visibility="{x:Bind BadgeVisible}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                Background="#99000000" CornerRadius="4" Padding="8,2">
          <TextBlock Text="{x:Bind Badge}" FontSize="11" Foreground="White"/>
        </Border>
        <Border Width="26" Height="26" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"
                Background="#88000000" BorderBrush="#CCFFFFFF" BorderThickness="1.5"
                Tapped="Check_Tapped" Visibility="{x:Bind CheckVisible, Mode=OneWay}">
          <Grid Background="{x:Bind CheckBrush, Mode=OneWay}" CornerRadius="4">
            <local:LineIcon Kind="check" Size="13" Foreground="White" Visibility="{x:Bind RingVisibleCheck, Mode=OneWay}"/>
          </Grid>
        </Border>
        <Border BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False"/>
        <Border BorderBrush="#FFFF7A45" BorderThickness="2.5" CornerRadius="6" IsHitTestVisible="False"
                Visibility="{x:Bind RingVisible, Mode=OneWay}"/>
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid x:Name="Host" Padding="16,12,16,0" RowSpacing="10" AllowDrop="True" DragOver="Host_DragOver" Drop="Host_Drop">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Grid Grid.Row="0" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button x:Name="BackBtn" Style="{StaticResource GlassButton}" Padding="11,9" Click="NavBack_Click" IsEnabled="False" ToolTipService.ToolTip="Back (Alt+Left)">
          <local:LineIcon Kind="back" Size="14"/></Button>
        <Button x:Name="FwdBtn" Style="{StaticResource GlassButton}" Padding="11,9" Click="NavFwd_Click" IsEnabled="False" ToolTipService.ToolTip="Forward (Alt+Right)">
          <local:LineIcon Kind="fwd" Size="14"/></Button>
      </StackPanel>

      <ToggleButton x:Name="FilterToggle" Visibility="Collapsed" Grid.Column="1" Style="{StaticResource GlassChip}" Padding="14,9" CornerRadius="6"
                    Checked="FilterToggle_Changed" Unchecked="FilterToggle_Changed" ToolTipService.ToolTip="Show filters">
        <StackPanel Orientation="Horizontal" Spacing="8"><local:LineIcon Kind="filter" Size="14"/><TextBlock Text="Filters" FontSize="13"/></StackPanel>
      </ToggleButton>

      <!-- The search pill: a frosted capsule. Each Enter adds a search tag; tags combine. -->
      <Border Grid.Column="2" Style="{StaticResource GlassPill}" Height="48" Padding="16,0,8,0" CornerRadius="8">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <local:LineIcon Kind="search" Size="15" Opacity="0.7" VerticalAlignment="Center"/>
          <StackPanel x:Name="QueryTags" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"/>
          <TextBox x:Name="SearchBox" Grid.Column="2" PlaceholderText="Describe what you are looking for…" FontSize="15"
                   BorderThickness="0" VerticalAlignment="Center" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"
                   AutomationProperties.Name="Search your files">
            <TextBox.Resources>
              <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
              <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
            </TextBox.Resources>
          </TextBox>
          <Button x:Name="VoiceBtn" Grid.Column="3" Style="{StaticResource GlassButton}" Padding="10,7" CornerRadius="6" Click="Voice_Click"
                  ToolTipService.ToolTip="Search by voice" AutomationProperties.Name="Search by voice">
            <local:LineIcon x:Name="VoiceIcon" Kind="mic" Size="15"/></Button>
        </Grid>
      </Border>

      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
        <DropDownButton x:Name="SortBtn" Style="{StaticResource GlassButton}" Padding="12,9" ToolTipService.ToolTip="Sort">
          <DropDownButton.Content><StackPanel Orientation="Horizontal" Spacing="8"><local:LineIcon Kind="sort" Size="14"/><TextBlock x:Name="SortText" Text="Newest" FontSize="13"/></StackPanel></DropDownButton.Content>
          <DropDownButton.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem Text="Newest first" Tag="mtime" Click="Sort_Click"/>
              <MenuFlyoutItem Text="Name A–Z" Tag="name" Click="Sort_Click"/>
              <MenuFlyoutItem Text="Largest first" Tag="size" Click="Sort_Click"/>
              <MenuFlyoutItem Text="By colour (rainbow)" Tag="color" Click="Sort_Click"/>
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <DropDownButton Style="{StaticResource GlassButton}" Padding="12,9" ToolTipService.ToolTip="Layout">
          <DropDownButton.Content><local:LineIcon x:Name="LayoutIcon" Kind="grid" Size="15"/></DropDownButton.Content>
          <DropDownButton.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem Text="Masonry · original shapes" Tag="masonry" Click="Layout_Click"></MenuFlyoutItem>
              <MenuFlyoutItem Text="Rows · edge-to-edge gallery" Tag="rows" Click="Layout_Click"></MenuFlyoutItem>
              <MenuFlyoutItem Text="Contact sheet · see more at once" Tag="contact" Click="Layout_Click"></MenuFlyoutItem>
              <MenuFlyoutItem Text="Storyboard · wide frames" Tag="story" Click="Layout_Click"></MenuFlyoutItem>
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <Button Style="{StaticResource GlassButton}" Padding="11,9" Click="SizeDown_Click" ToolTipService.ToolTip="Smaller tiles"><local:LineIcon Kind="minus" Size="14"/></Button>
        <Button Style="{StaticResource GlassButton}" Padding="11,9" Click="SizeUp_Click" ToolTipService.ToolTip="Bigger tiles"><local:LineIcon Kind="plus" Size="14"/></Button>
        <Button Style="{StaticResource GlassAccentButton}" Click="AddFolder_Click" Padding="14,9">
          <StackPanel Orientation="Horizontal" Spacing="8"><local:LineIcon Kind="folderplus" Size="14"/><TextBlock Text="Add folder" FontSize="13"/></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Title, active filters and indexing progress -->
    <Grid Grid.Row="1" ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <TextBlock x:Name="PageTitle" Text="Library" Style="{StaticResource TitleText}" FontSize="26"/>
          <TextBlock x:Name="Summary" Style="{StaticResource SecondaryText}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
        </StackPanel>
        <local:WrapPanel x:Name="ActiveChips"/>
      </StackPanel>
      <Border x:Name="IndexStrip" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource GlassCard}" Padding="16,10" CornerRadius="6" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <StackPanel Spacing="5" VerticalAlignment="Center">
            <TextBlock x:Name="IndexText" FontSize="13"/>
            <ProgressBar x:Name="IndexBar" Width="220" Minimum="0" Maximum="1"/>
          </StackPanel>
          <Button Style="{StaticResource GlassButton}" Content="Pause" Click="PauseIndex_Click" Padding="12,6" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Filters | tiles | inspector -->
    <Grid x:Name="BodyGrid" Grid.Row="2" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="FilterColumn" Width="0"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="DetailColumn" Width="0"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="FilterPanel" Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0" Visibility="Visible">
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
          <StackPanel x:Name="SectionStack" Spacing="24" Padding="16,6,16,20">

            <StackPanel x:Name="SecTypes" Spacing="8">
              <local:WrapPanel x:Name="TypeChips" Columns="3" Spacing="6"/>
            </StackPanel>

            <StackPanel x:Name="SecTags" Spacing="10">
              <Grid>
                <TextBlock Text="Tags" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Right" Padding="7,2" CornerRadius="4" Click="NewTag_Click" ToolTipService.ToolTip="New tag">
                  <local:LineIcon Kind="plus" Size="11"/></Button>
              </Grid>
              <local:WrapPanel x:Name="TagChips" Spacing="6" Justify="True"/>
            </StackPanel>

            <StackPanel x:Name="SecSources" Spacing="10">
              <TextBlock Text="Sources" Style="{StaticResource SectionLabel}"/>
              <local:WrapPanel x:Name="SourceChips" Spacing="6" Justify="True"/>
            </StackPanel>

            <StackPanel x:Name="SecColours" Spacing="10">
              <TextBlock Text="Colours" Style="{StaticResource SectionLabel}"/>
              <Border x:Name="ColorBox" MaxHeight="51" PointerEntered="Colors_Enter" PointerExited="Colors_Exit">
                <local:WrapPanel x:Name="ColorDots" Spacing="7"/>
              </Border>
            </StackPanel>

            <StackPanel x:Name="SecFolders" Spacing="10">
              <Grid>
                <TextBlock Text="Folders" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Right" Padding="7,2" CornerRadius="4" Click="AddFolder_Click" ToolTipService.ToolTip="Add a folder">
                  <local:LineIcon Kind="plus" Size="11"/></Button>
              </Grid>
              <StackPanel x:Name="FolderList" Spacing="4"/>
            </StackPanel>

            <StackPanel x:Name="SecMoods" Spacing="10">
              <TextBlock Text="Looks &amp; moods" Style="{StaticResource SectionLabel}"/>
              <local:WrapPanel x:Name="MoodChips" Spacing="6" Justify="True"/>
            </StackPanel>

            <StackPanel x:Name="SecSpaces" Spacing="10">
              <Grid>
                <TextBlock Text="Spaces" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Right" Padding="7,2" CornerRadius="4" Click="NewSpace_Click" ToolTipService.ToolTip="New space">
                  <local:LineIcon Kind="plus" Size="11"/></Button>
              </Grid>
              <local:WrapPanel x:Name="SpaceChips" Spacing="6" Justify="True"/>
            </StackPanel>

            <StackPanel x:Name="SecDetails" Spacing="10">
              <TextBlock Text="Refine" Style="{StaticResource SectionLabel}"/>
              <StackPanel x:Name="RefineGroups" Spacing="10"/>
              <TextBlock x:Name="RefineEmpty" Visibility="Collapsed" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap"
                         Text="Everything here is alike in size, shape and date. Nothing to narrow."/>
              <Expander Header="Exact values" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" Padding="8">
                <StackPanel Spacing="10">
                  <CalendarDatePicker x:Name="FFrom" Header="From date" HorizontalAlignment="Stretch" DateChanged="Detail_Changed"/>
                  <CalendarDatePicker x:Name="FThrough" Header="Through date" HorizontalAlignment="Stretch" DateChanged="Detail_Changed"/>
                  <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <NumberBox x:Name="FMinMb" Header="Min MB" PlaceholderText="Any" Minimum="0" ValueChanged="Detail_ValueChanged"/>
                    <NumberBox x:Name="FMaxMb" Grid.Column="1" Header="Max MB" PlaceholderText="Any" Minimum="0" ValueChanged="Detail_ValueChanged"/></Grid>
                  <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <NumberBox x:Name="FMinW" Header="Min width px" PlaceholderText="Any" Minimum="0" ValueChanged="Detail_ValueChanged"/>
                    <NumberBox x:Name="FMinH" Grid.Column="1" Header="Min height px" PlaceholderText="Any" Minimum="0" ValueChanged="Detail_ValueChanged"/></Grid>
                  <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <NumberBox x:Name="FMinLen" Header="Min length s" PlaceholderText="Any" Minimum="0" ValueChanged="Detail_ValueChanged"/>
                    <NumberBox x:Name="FMaxLen" Grid.Column="1" Header="Max length s" PlaceholderText="Any" Minimum="0" ValueChanged="Detail_ValueChanged"/></Grid>
                  <NumberBox x:Name="FMinFps" Header="Minimum frame rate" PlaceholderText="Any" Minimum="0" ValueChanged="Detail_ValueChanged"/>
                  <ComboBox x:Name="FAspect" Header="Shape" HorizontalAlignment="Stretch" SelectionChanged="Detail_SelectionChanged" SelectedIndex="0">
                    <ComboBoxItem Content="Any shape" Tag=""/><ComboBoxItem Content="Landscape" Tag="landscape"/><ComboBoxItem Content="Portrait" Tag="portrait"/>
                    <ComboBoxItem Content="Square" Tag="square"/><ComboBoxItem Content="Wide" Tag="wide"/>
                  </ComboBox>
                  <ComboBox x:Name="FCodec" Header="Codec" HorizontalAlignment="Stretch" SelectionChanged="Detail_SelectionChanged" SelectedIndex="0">
                    <ComboBoxItem Content="Any codec" Tag=""/><ComboBoxItem Content="H.264" Tag="h264"/><ComboBoxItem Content="HEVC" Tag="hevc"/>
                    <ComboBoxItem Content="AV1" Tag="av1"/><ComboBoxItem Content="VP9" Tag="vp9"/><ComboBoxItem Content="ProRes" Tag="prores"/>
                  </ComboBox>
                </StackPanel>
              </Expander>
              <Button x:Name="ClearFiltersBtn" Content="Clear filters" Click="ClearFilters_Click" Style="{StaticResource GlassButton}" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Tiles -->
      <Grid Grid.Column="1">
        <ScrollViewer x:Name="TileScroll" ViewChanged="TileScroll_ViewChanged" VerticalScrollBarVisibility="Hidden" Padding="0">
          <ItemsRepeater x:Name="TileRepeater" Margin="0,8,0,0" ItemTemplate="{StaticResource TileTemplate}" Layout="{StaticResource TileLayoutInstance}"/>
        </ScrollViewer>


        <!-- Tiles dissolve into the page at both edges instead of being cut off -->
        <Rectangle Height="34" VerticalAlignment="Top" IsHitTestVisible="False" Fill="{StaticResource FadeTopBrush}"/>
        <Rectangle Height="28" VerticalAlignment="Bottom" IsHitTestVisible="False" Fill="{StaticResource FadeBottomBrush}"/>

        <Border x:Name="EmptyCard" Visibility="Collapsed" Style="{StaticResource GlassCard}" MaxWidth="460"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
          <StackPanel Spacing="12">
            <TextBlock x:Name="EmptyTitle" Style="{StaticResource TitleText}" FontSize="22"/>
            <TextBlock x:Name="EmptyBody" Style="{StaticResource SecondaryText}" FontSize="14" TextWrapping="Wrap"/>
            <Button x:Name="EmptyAction" Content="Add a folder" Style="{StaticResource GlassAccentButton}" Click="AddFolder_Click" HorizontalAlignment="Left" Visibility="Collapsed"/>
          </StackPanel>
        </Border>
        <ProgressRing x:Name="Busy" IsActive="False" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Floating bar for whatever is ticked -->
        <Border x:Name="ActionBar" Visibility="Collapsed" Style="{StaticResource GlassCard}" CornerRadius="8" Padding="18,10"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                Background="{StaticResource OverlayBrush}" BorderBrush="{StaticResource GlassStrokeBrush}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="SelCount" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Button x:Name="FavBtn" Style="{StaticResource GlassButton}" Click="Favourite_Click" Padding="10,7" ToolTipService.ToolTip="Favourite (F)">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:LineIcon x:Name="FavIcon" Kind="star" Size="13"/><TextBlock x:Name="FavText" Text="Favourite"/></StackPanel></Button>
            <Button Style="{StaticResource GlassButton}" Click="TagSel_Click" Padding="10,7" ToolTipService.ToolTip="Tag">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:LineIcon Kind="tag" Size="13"/><TextBlock Text="Tag"/></StackPanel></Button>
            <Border Width="1" Height="18" Background="{StaticResource DividerBrush}" Margin="4,0"/>
            <ComboBox x:Name="SpacePick" MinWidth="150" PlaceholderText="Choose a space" VerticalAlignment="Center"/>
            <Button Style="{StaticResource GlassAccentButton}" Click="AddToSpace_Click" Padding="12,7">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:LineIcon Kind="plus" Size="12"/><TextBlock Text="Add to space"/></StackPanel></Button>
            <Button Style="{StaticResource GlassButton}" Content="New space" Click="NewSpaceFromSel_Click" Padding="12,7"/>
            <Button x:Name="RemoveFromSpaceBtn" Style="{StaticResource GlassButton}" Content="Remove" Click="RemoveFromSpace_Click" Padding="12,7" Visibility="Collapsed"/>
            <Button Style="{StaticResource GlassButton}" Content="Copy to…" Click="CopyTo_Click" Padding="12,7"/>
            <Button Style="{StaticResource GlassButton}" Content="Move to…" Click="MoveTo_Click" Padding="12,7"/>
            <Button Style="{StaticResource GlassButton}" Content="Delete" Click="Delete_Click" Padding="12,7" Foreground="#FFFF7A7A"/>
            <Button Style="{StaticResource GlassButton}" Content="Select all" Click="SelectAll_Click" Padding="12,7"/>
            <Button Style="{StaticResource GlassButton}" Click="SelectNone_Click" Padding="10,7" ToolTipService.ToolTip="Clear"><local:LineIcon Kind="close" Size="12"/></Button>
          </StackPanel>
        </Border>

        <!-- A short message that fades by itself -->
        <Border x:Name="Toast" Visibility="Collapsed" Style="{StaticResource GlassCard}" CornerRadius="6" Padding="18,10"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" Background="{StaticResource OverlayBrush}">
          <TextBlock x:Name="ToastText" FontSize="13"/>
        </Border>
      </Grid>

      <!-- Inspector -->
      <Border x:Name="Detail" Grid.Column="2" Style="{StaticResource GlassCard}" Visibility="Collapsed" Padding="0">
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
          <StackPanel Spacing="14" Padding="18">
            <Border CornerRadius="6" Height="250" Background="{StaticResource GlassFillBrush}">
              <Grid>
                <Image x:Name="Preview" Stretch="Uniform"/>
                <local:LineIcon x:Name="PreviewGlyph" Size="52" Opacity="0.5"/>
                <Button x:Name="PlayBtn" Style="{StaticResource GlassButton}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="10" Padding="20,16" Click="Open_Click" Visibility="Collapsed" ToolTipService.ToolTip="Play in your default player">
                  <local:LineIcon Kind="play" Size="22"/></Button>
              </Grid>
            </Border>
            <TextBlock x:Name="DName" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            <TextBlock x:Name="DMeta" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
            <StackPanel x:Name="DColorsBox" Spacing="6" Visibility="Collapsed">
              <TextBlock Text="Colours" Style="{StaticResource SectionLabel}"/>
              <StackPanel x:Name="DColors" Orientation="Horizontal" Spacing="6"/>
            </StackPanel>
            <StackPanel x:Name="DSpacesBox" Spacing="6" Visibility="Collapsed">
              <TextBlock Text="In spaces" Style="{StaticResource SectionLabel}"/>
              <local:WrapPanel x:Name="DSpaces"/>
            </StackPanel>
            <TextBlock x:Name="DPath" Style="{StaticResource SecondaryText}" Foreground="{StaticResource GlassTextTertiaryBrush}" TextWrapping="Wrap" FontSize="11" IsTextSelectionEnabled="True"/>
            <Grid ColumnSpacing="8" RowSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Button Content="Open" Click="Open_Click" HorizontalAlignment="Stretch" Style="{StaticResource GlassAccentButton}"/>
              <Button Grid.Column="1" Content="Show in folder" Click="Reveal_Click" HorizontalAlignment="Stretch" Style="{StaticResource GlassButton}"/>
              <Button Grid.Row="1" Content="More like this" Click="Similar_Click" HorizontalAlignment="Stretch" Style="{StaticResource GlassButton}"/>
              <Button Grid.Row="1" Grid.Column="1" Content="Copy path" Click="CopyPath_Click" HorizontalAlignment="Stretch" Style="{StaticResource GlassButton}"/>
              <Button x:Name="TranscriptBtn" Grid.Row="2" Grid.ColumnSpan="2" Content="Show what is said" Click="Transcript_Click" HorizontalAlignment="Stretch" Style="{StaticResource GlassButton}" Visibility="Collapsed"/>
            </Grid>
            <TextBlock Text="Drag any tile into Photoshop, After Effects, CapCut or Explorer to use the original file."
                       Style="{StaticResource SecondaryText}" Foreground="{StaticResource GlassTextTertiaryBrush}" TextWrapping="Wrap" FontSize="12"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Page>

