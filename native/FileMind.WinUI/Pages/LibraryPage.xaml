<Page x:Class="FileMind.Pages.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:FileMind.Pages">
  <Page.Resources>
    <local:TileLayout x:Key="TileLayoutInstance"/>

    <DataTemplate x:Key="TileTemplate" x:DataType="local:TileVm">
      <Grid CornerRadius="8" Background="{StaticResource GlassFillBrush}" CanDrag="True" Tag="{x:Bind}"
            DragStarting="Tile_DragStarting" Tapped="Tile_Tapped"
            PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
        <Image Source="{x:Bind Thumb}" Stretch="UniformToFill" Visibility="{x:Bind ThumbVisible}"/>
        <local:LineIcon Kind="{x:Bind IconKind}" Size="38" Opacity="0.5" Visibility="{x:Bind GlyphVisible}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <local:AudioCard Vm="{x:Bind}" Visibility="{x:Bind AudioVisible}"/>
        <Rectangle Fill="{StaticResource TileScrimBrush}" Height="70" VerticalAlignment="Bottom"
                   Visibility="{x:Bind NameVisible, Mode=OneWay}"/>
        <TextBlock Text="{x:Bind Name}" FontSize="12" Margin="12,0,12,10" VerticalAlignment="Bottom"
                   TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="White"
                   Visibility="{x:Bind NameVisible, Mode=OneWay}"/>
        <Border Visibility="{x:Bind BadgeVisible}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                Background="#99000000" CornerRadius="4" Padding="8,2">
          <TextBlock Text="{x:Bind Badge}" FontSize="11" Foreground="White"/>
        </Border>
        <Border Width="26" Height="26" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"
                Background="#88000000" BorderBrush="#CCFFFFFF" BorderThickness="1.5"
                Tapped="Check_Tapped" Visibility="{x:Bind CheckVisible, Mode=OneWay}">
          <Grid Background="{x:Bind CheckBrush, Mode=OneWay}" CornerRadius="4">
            <local:LineIcon Kind="check" Size="13" Foreground="White" Visibility="{x:Bind RingVisibleCheck, Mode=OneWay}"/>
          </Grid>
        </Border>
        <Border BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False"/>
        <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2.5" CornerRadius="8" IsHitTestVisible="False"
                Visibility="{x:Bind RingVisible, Mode=OneWay}"/>
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid x:Name="Host" AllowDrop="True" DragOver="Host_DragOver" Drop="Host_Drop">
    <!-- Filters | tiles | inspector. The tiles fill the page and scroll under the toolbar and off the bottom edge. -->
    <Grid x:Name="BodyGrid" ColumnSpacing="0" Padding="12,0,12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="FilterColumn" Width="0"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="DetailColumn" Width="0"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="FilterPanel" Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0" Visibility="Visible">
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
          <StackPanel x:Name="SectionStack" Spacing="18" Padding="2,14,2,16">

            <StackPanel x:Name="SecTypes" Spacing="6">
              <local:WrapPanel x:Name="TypeChips" Columns="3" Spacing="6"/>
            </StackPanel>

            <StackPanel x:Name="SecTags" Spacing="8">
              <Grid>
                <TextBlock Text="Tags" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Right" Padding="6,1" CornerRadius="4" Click="NewTag_Click" ToolTipService.ToolTip="New tag">
                  <local:LineIcon Kind="plus" Size="11"/></Button>
              </Grid>
              <local:WrapPanel x:Name="TagChips" Columns="2" Spacing="6"/>
            </StackPanel>

            <StackPanel x:Name="SecSources" Spacing="8">
              <TextBlock Text="Sources" Style="{StaticResource SectionLabel}"/>
              <local:WrapPanel x:Name="SourceChips" Columns="2" Spacing="6"/>
            </StackPanel>

            <StackPanel x:Name="SecColours" Spacing="8">
              <TextBlock Text="Colours" Style="{StaticResource SectionLabel}"/>
              <local:WrapPanel x:Name="ColorDots" Columns="9" Spacing="8"/>
            </StackPanel>

            <StackPanel x:Name="SecFolders" Spacing="8">
              <Grid>
                <TextBlock Text="Folders" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Right" Padding="6,1" CornerRadius="4" Click="AddFolder_Click" ToolTipService.ToolTip="Add a folder">
                  <local:LineIcon Kind="plus" Size="11"/></Button>
              </Grid>
              <StackPanel x:Name="FolderList" Spacing="2"/>
            </StackPanel>

            <StackPanel x:Name="SecMoods" Spacing="8">
              <TextBlock Text="Looks &amp; moods" Style="{StaticResource SectionLabel}"/>
              <local:WrapPanel x:Name="MoodChips" Columns="2" Spacing="6"/>
            </StackPanel>

            <StackPanel x:Name="SecSpaces" Spacing="8">
              <Grid>
                <TextBlock Text="Spaces" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Right" Padding="6,1" CornerRadius="4" Click="NewSpace_Click" ToolTipService.ToolTip="New space">
                  <local:LineIcon Kind="plus" Size="11"/></Button>
              </Grid>
              <StackPanel x:Name="SpaceList" Spacing="2"/>
            </StackPanel>

            <StackPanel x:Name="SecDetails" Spacing="8">
              <TextBlock Text="Refine" Style="{StaticResource SectionLabel}"/>
              <StackPanel x:Name="RefineGroups" Spacing="10"/>
              <TextBlock x:Name="RefineEmpty" Visibility="Collapsed" Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap"
                         Text="Everything here is alike in size, shape and date. Nothing to narrow."/>
              <ToggleButton x:Name="ExactToggle" Style="{StaticResource GlassChip}" Height="28" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,0" CornerRadius="6" Click="Exact_Click" Content="Exact values"/>
              <Border x:Name="ExactPanel" Visibility="Collapsed" Padding="2,4,2,0">
                <StackPanel Spacing="8">
                  <CalendarDatePicker x:Name="FFrom" Header="From date" HorizontalAlignment="Stretch" DateChanged="Detail_Changed"/>
                  <CalendarDatePicker x:Name="FThrough" Header="Through date" HorizontalAlignment="Stretch" DateChanged="Detail_Changed"/>
                  <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <NumberBox x:Name="FMinMb" Header="Min MB" PlaceholderText="Any" Minimum="0" ValueChanged="Detail_ValueChanged"/>
                    <NumberBox x:Name="FMaxMb" Grid.Column="1" Header="Max MB" PlaceholderText="Any" Minimum="0" ValueChanged="Detail_ValueChanged"/></Grid>
                  <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <NumberBox x:Name="FMinW" Header="Min width px" PlaceholderText="Any" Minimum="0" ValueChanged="Detail_ValueChanged"/>
                    <NumberBox x:Name="FMinH" Grid.Column="1" Header="Min height px" PlaceholderText="Any" Minimum="0" ValueChanged="Detail_ValueChanged"/></Grid>
                  <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <NumberBox x:Name="FMinLen" Header="Min length s" PlaceholderText="Any" Minimum="0" ValueChanged="Detail_ValueChanged"/>
                    <NumberBox x:Name="FMaxLen" Grid.Column="1" Header="Max length s" PlaceholderText="Any" Minimum="0" ValueChanged="Detail_ValueChanged"/></Grid>
                  <NumberBox x:Name="FMinFps" Header="Minimum frame rate" PlaceholderText="Any" Minimum="0" ValueChanged="Detail_ValueChanged"/>
                  <ComboBox x:Name="FAspect" Header="Shape" HorizontalAlignment="Stretch" SelectionChanged="Detail_SelectionChanged" SelectedIndex="0">
                    <ComboBoxItem Content="Any shape" Tag=""/><ComboBoxItem Content="Landscape" Tag="landscape"/><ComboBoxItem Content="Portrait" Tag="portrait"/>
                    <ComboBoxItem Content="Square" Tag="square"/><ComboBoxItem Content="Wide" Tag="wide"/>
                  </ComboBox>
                  <ComboBox x:Name="FCodec" Header="Codec" HorizontalAlignment="Stretch" SelectionChanged="Detail_SelectionChanged" SelectedIndex="0">
                    <ComboBoxItem Content="Any codec" Tag=""/><ComboBoxItem Content="H.264" Tag="h264"/><ComboBoxItem Content="HEVC" Tag="hevc"/>
                    <ComboBoxItem Content="AV1" Tag="av1"/><ComboBoxItem Content="VP9" Tag="vp9"/><ComboBoxItem Content="ProRes" Tag="prores"/>
                  </ComboBox>
                </StackPanel>
              </Border>
              <Button x:Name="ClearFiltersBtn" Content="Clear filters" FontSize="12" Height="28" Padding="10,0" Click="ClearFilters_Click" Style="{StaticResource GlassButton}" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Tiles -->
      <Grid Grid.Column="1">
        <ScrollViewer x:Name="TileScroll" ViewChanged="TileScroll_ViewChanged" VerticalScrollBarVisibility="Hidden" Padding="0">
          <ItemsRepeater x:Name="TileRepeater" Margin="0,88,0,24" ItemTemplate="{StaticResource TileTemplate}" Layout="{StaticResource TileLayoutInstance}"/>
        </ScrollViewer>


        <!-- A space that is open offers files that probably belong in it. Nothing is added until you press the tick. -->
        <Border x:Name="SuggestStrip" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,88,0,0" Padding="12,8,12,10"
                Style="{StaticResource GlassCard}" SizeChanged="SuggestStrip_SizeChanged">
          <StackPanel Spacing="8">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Suggested for this space" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="SuggestCount" FontSize="11.5" Foreground="{StaticResource GlassTextTertiaryBrush}"/>
              </StackPanel>
              <Button x:Name="SuggestAllBtn" Grid.Column="1" Content="Add all shown" FontSize="12" Height="26" Padding="10,0" CornerRadius="6"
                      Style="{StaticResource GlassButton}" Click="SuggestAll_Click"/>
              <Button x:Name="SuggestToggle" Grid.Column="2" Style="{StaticResource BarButton}" Width="26" Height="26" Click="SuggestToggle_Click"
                      AutomationProperties.Name="Show or hide suggestions" ToolTipService.ToolTip="Show or hide suggestions">
                <local:LineIcon x:Name="SuggestChevron" Kind="chevup" Size="14"/></Button>
            </Grid>
            <ScrollViewer x:Name="SuggestScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
              <StackPanel x:Name="SuggestRow" Orientation="Horizontal" Spacing="8" Padding="0,0,0,6"/>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <Border x:Name="EmptyCard" Visibility="Collapsed" Style="{StaticResource GlassCard}" MaxWidth="460"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
          <StackPanel Spacing="12">
            <TextBlock x:Name="EmptyTitle" Style="{StaticResource TitleText}" FontSize="22"/>
            <TextBlock x:Name="EmptyBody" Style="{StaticResource SecondaryText}" FontSize="14" TextWrapping="Wrap"/>
            <Button x:Name="EmptyAction" Content="Add a folder" Style="{StaticResource GlassAccentButton}" Click="AddFolder_Click" HorizontalAlignment="Left" Visibility="Collapsed"/>
          </StackPanel>
        </Border>
        <ProgressRing x:Name="Busy" IsActive="False" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Floating bar for whatever is ticked: icons with short labels on frosted glass -->
        <Border x:Name="ActionBar" Visibility="Collapsed" CornerRadius="8" Padding="10,7" Translation="0,0,24"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                Background="{StaticResource ToolbarGlassBrush}" BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1">
          <Border.Shadow><ThemeShadow/></Border.Shadow>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock x:Name="SelCount" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="6,0,8,0"/>
            <Button x:Name="FavBtn" Style="{StaticResource GlassButton}" Click="Favourite_Click" Padding="9,5" ToolTipService.ToolTip="Favourite">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:LineIcon x:Name="FavIcon" Kind="star" Size="13"/><TextBlock x:Name="FavText" Text="Favourite" FontSize="12.5"/></StackPanel></Button>
            <Button Style="{StaticResource GlassButton}" Click="TagSel_Click" Padding="9,5" ToolTipService.ToolTip="Tag the selected files">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:LineIcon Kind="tag" Size="13"/><TextBlock Text="Tag" FontSize="12.5"/></StackPanel></Button>
            <Border Width="1" Height="18" Background="{StaticResource DividerBrush}" Margin="4,0"/>
            <ComboBox x:Name="SpacePick" MinWidth="130" PlaceholderText="Choose a space" VerticalAlignment="Center" FontSize="12.5"/>
            <Button Style="{StaticResource GlassAccentButton}" Click="AddToSpace_Click" Padding="9,5">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:LineIcon Kind="plus" Size="12" Foreground="White"/><TextBlock Text="Add" FontSize="12.5"/></StackPanel></Button>
            <Button Style="{StaticResource GlassButton}" Click="NewSpaceFromSel_Click" Padding="9,5" ToolTipService.ToolTip="Make a new space from these files">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:LineIcon Kind="folderplus" Size="13"/><TextBlock Text="New space" FontSize="12.5"/></StackPanel></Button>
            <Button x:Name="RemoveFromSpaceBtn" Style="{StaticResource GlassButton}" Content="Remove" FontSize="12.5" Click="RemoveFromSpace_Click" Padding="9,5" Visibility="Collapsed"/>
            <Border Width="1" Height="18" Background="{StaticResource DividerBrush}" Margin="4,0"/>
            <Button Style="{StaticResource GlassButton}" Content="Copy to…" FontSize="12.5" Click="CopyTo_Click" Padding="9,5"/>
            <Button Style="{StaticResource GlassButton}" Content="Move to…" FontSize="12.5" Click="MoveTo_Click" Padding="9,5"/>
            <Button Style="{StaticResource GlassButton}" Click="Export_Click" Padding="9,5" ToolTipService.ToolTip="Convert, shrink or resize the selected files into new files">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:LineIcon Kind="export" Size="13"/><TextBlock Text="Export" FontSize="12.5"/></StackPanel></Button>
            <Button Style="{StaticResource GlassButton}" Click="Delete_Click" Padding="9,5">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:LineIcon Kind="trash" Size="13" Foreground="#FFD93A3F"/><TextBlock Text="Delete" FontSize="12.5" Foreground="#FFD93A3F"/></StackPanel></Button>
            <Button Style="{StaticResource GlassButton}" Content="Select all" FontSize="12.5" Click="SelectAll_Click" Padding="9,5"/>
            <Button Style="{StaticResource BarButton}" Click="SelectNone_Click" ToolTipService.ToolTip="Clear selection"><local:LineIcon Kind="close" Size="12"/></Button>
          </StackPanel>
        </Border>

        <!-- A short message that fades by itself -->
        <Border x:Name="Toast" Visibility="Collapsed" Style="{StaticResource GlassCard}" CornerRadius="8" Padding="18,10"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,96,0,0" Background="{StaticResource OverlayBrush}">
          <TextBlock x:Name="ToastText" FontSize="13"/>
        </Border>
      </Grid>

      <!-- Inspector -->
      <Border x:Name="Detail" Grid.Column="2" Style="{StaticResource GlassCard}" Visibility="Collapsed" Padding="0" Margin="16,88,0,16">
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
          <StackPanel Spacing="14" Padding="18">
            <Border CornerRadius="6" Height="250" Background="{StaticResource GlassFillBrush}">
              <Grid>
                <Image x:Name="Preview" Stretch="Uniform"/>
                <local:LineIcon x:Name="PreviewGlyph" Size="52" Opacity="0.5"/>
                <Button x:Name="PlayBtn" Style="{StaticResource GlassButton}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="10" Padding="20,16" Click="Open_Click" Visibility="Collapsed" ToolTipService.ToolTip="Play in your default player">
                  <local:LineIcon Kind="play" Size="22"/></Button>
              </Grid>
            </Border>
            <TextBlock x:Name="DName" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            <TextBlock x:Name="DMeta" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
            <StackPanel x:Name="DColorsBox" Spacing="6" Visibility="Collapsed">
              <TextBlock Text="Colours" Style="{StaticResource SectionLabel}"/>
              <StackPanel x:Name="DColors" Orientation="Horizontal" Spacing="6"/>
            </StackPanel>
            <StackPanel x:Name="DSpacesBox" Spacing="6" Visibility="Collapsed">
              <TextBlock Text="In spaces" Style="{StaticResource SectionLabel}"/>
              <local:WrapPanel x:Name="DSpaces"/>
            </StackPanel>
            <TextBlock x:Name="DPath" Style="{StaticResource SecondaryText}" Foreground="{StaticResource GlassTextTertiaryBrush}" TextWrapping="Wrap" FontSize="11" IsTextSelectionEnabled="True"/>
            <Grid ColumnSpacing="8" RowSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Button Content="Open" Click="Open_Click" HorizontalAlignment="Stretch" Style="{StaticResource GlassAccentButton}"/>
              <Button Grid.Column="1" Content="Show in folder" Click="Reveal_Click" HorizontalAlignment="Stretch" Style="{StaticResource GlassButton}"/>
              <Button Grid.Row="1" Content="More like this" Click="Similar_Click" HorizontalAlignment="Stretch" Style="{StaticResource GlassButton}"/>
              <Button Grid.Row="1" Grid.Column="1" Content="Copy path" Click="CopyPath_Click" HorizontalAlignment="Stretch" Style="{StaticResource GlassButton}"/>
              <Button x:Name="TranscriptBtn" Grid.Row="2" Grid.ColumnSpan="2" Content="Show what is said" Click="Transcript_Click" HorizontalAlignment="Stretch" Style="{StaticResource GlassButton}" Visibility="Collapsed"/>
            </Grid>
            <TextBlock Text="Drag any tile into Photoshop, After Effects, CapCut or Explorer to use the original file."
                       Style="{StaticResource SecondaryText}" Foreground="{StaticResource GlassTextTertiaryBrush}" TextWrapping="Wrap" FontSize="12"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- The Library's own top-bar row: the search pill stretches to fill, the tools follow it. MainWindow takes it while the Library shows. -->
    <Grid x:Name="ToolbarRow" ColumnSpacing="10" VerticalAlignment="Center" HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="200"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- The search pill. Each Enter adds a search tag; tags combine. -->
      <Border x:Name="SearchPill" Height="32" CornerRadius="8" Padding="10,0,2,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
              Background="{StaticResource FieldFillBrush}" BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <local:LineIcon Kind="search" Size="14" VerticalAlignment="Center"/>
          <StackPanel x:Name="QueryTags" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"/>
          <Grid Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="SearchHint" Text="Search your files…" FontSize="13.5" IsHitTestVisible="False"
                       VerticalAlignment="Center" Foreground="{StaticResource GlassTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            <TextBox x:Name="SearchBox" FontSize="13.5" BorderThickness="0" Padding="0,4,6,5" MinHeight="0" VerticalAlignment="Center" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"
                     GotFocus="SearchBox_Focus" LostFocus="SearchBox_Focus" AutomationProperties.Name="Search your files">
              <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
              </TextBox.Resources>
            </TextBox>
          </Grid>
          <Button x:Name="VoiceBtn" Grid.Column="3" Style="{StaticResource BarButton}" Width="26" Height="26" Click="Voice_Click"
                  ToolTipService.ToolTip="Search by voice" AutomationProperties.Name="Search by voice">
            <local:LineIcon x:Name="VoiceIcon" Kind="mic" Size="15"/></Button>
        </Grid>
      </Border>

      <StackPanel x:Name="ToolButtons" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button x:Name="SortBtn" Style="{StaticResource BoxButton}" Padding="10,0" ToolTipService.ToolTip="Sort" AutomationProperties.Name="Sort">
          <StackPanel Orientation="Horizontal" Spacing="7"><local:LineIcon Kind="sort" Size="14"/><TextBlock x:Name="SortText" Text="Newest" FontSize="12.5"/></StackPanel>
          <Button.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem Text="Newest first" Tag="mtime" Click="Sort_Click"/>
              <MenuFlyoutItem Text="Name A–Z" Tag="name" Click="Sort_Click"/>
              <MenuFlyoutItem Text="Largest first" Tag="size" Click="Sort_Click"/>
              <MenuFlyoutItem Text="By colour (rainbow)" Tag="color" Click="Sort_Click"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Style="{StaticResource BoxButton}" ToolTipService.ToolTip="Layout" AutomationProperties.Name="Layout">
          <local:LineIcon x:Name="LayoutIcon" Kind="grid" Size="15"/>
          <Button.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem Text="Masonry · original shapes" Tag="masonry" Click="Layout_Click"/>
              <MenuFlyoutItem Text="Rows · edge-to-edge gallery" Tag="rows" Click="Layout_Click"/>
              <MenuFlyoutItem Text="Contact sheet · see more at once" Tag="contact" Click="Layout_Click"/>
              <MenuFlyoutItem Text="Storyboard · wide frames" Tag="story" Click="Layout_Click"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Style="{StaticResource BoxButton}" Click="SizeDown_Click" ToolTipService.ToolTip="Smaller tiles" AutomationProperties.Name="Smaller tiles"><local:LineIcon Kind="minus" Size="15"/></Button>
        <Button Style="{StaticResource BoxButton}" Click="SizeUp_Click" ToolTipService.ToolTip="Bigger tiles" AutomationProperties.Name="Bigger tiles"><local:LineIcon Kind="plus" Size="15"/></Button>
        <Button Style="{StaticResource BoxAccentButton}" Padding="12,0" Click="AddFolder_Click" ToolTipService.ToolTip="Add a folder" AutomationProperties.Name="Add folder">
          <StackPanel Orientation="Horizontal" Spacing="7"><local:LineIcon Kind="folderplus" Size="14" Foreground="White"/><TextBlock Text="Add folder" FontSize="12.5"/></StackPanel></Button>
      </StackPanel>
    </Grid>

    <!-- Row 2 of the bar: the page title with its counts, the active filters, and indexing progress. -->
    <Border x:Name="TopBand" VerticalAlignment="Top" Margin="0,54,0,0" MinHeight="36" Background="{StaticResource ToolbarGlassBrush}" Padding="12,0,12,0" SizeChanged="TopBand_SizeChanged">
      <Grid ColumnSpacing="14" MinHeight="36">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="PageTitle" Text="Library" Style="{StaticResource TitleText}" FontSize="24" VerticalAlignment="Center" Margin="0,0,0,3"/>
        <TextBlock x:Name="Summary" Grid.Column="1" Style="{StaticResource SecondaryText}" FontSize="12.5" VerticalAlignment="Center" Margin="0,2,0,0"/>
        <local:WrapPanel x:Name="ActiveChips" Grid.Column="2" Spacing="4" VerticalAlignment="Center" Margin="0,5"/>
        <StackPanel x:Name="IndexStrip" Grid.Column="3" Visibility="Collapsed" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock x:Name="IndexText" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource GlassTextSecondaryBrush}"/>
          <ProgressBar x:Name="IndexBar" Width="120" Minimum="0" Maximum="1" VerticalAlignment="Center"/>
          <Button Style="{StaticResource GlassButton}" Content="Pause" FontSize="11.5" Click="PauseIndex_Click" Padding="8,0" Height="22" VerticalAlignment="Center" CornerRadius="5"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Page>

